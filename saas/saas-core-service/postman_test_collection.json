    "name": "saas-core-service",
    "description": "Full test collection for soulcut SaaS core service.\n\nBase URL: http://127.0.0.1:8080\n\nCurrent behavior:\n- Register creates t_user_info + t_user_role_relation(tenant_id=0, TENANT_USER)\n- Register does NOT bind the user to any tenant\n- Login returns tenant_id = 0\n- LLM usage / integral / member endpoints are token-based (JWT subject)\n\nRun in order: Register -> Login -> Get -> List -> Count -> Update -> Delete.\nFor the LLM folder, run Register -> Login first so that {{token}} is set.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "User",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"code is 0\", function () {",
                  "    pm.expect(pm.response.json().code).to.eql(0);",
                  "});",
                  "pm.test(\"role is TENANT_USER\", function () {",
                  "    pm.expect(pm.response.json().data.role).to.eql(\"TENANT_USER\");",
                  "});",
                  "pm.test(\"no tenant_id in register response\", function () {",
                  "    pm.expect(pm.response.json().data).to.not.have.property(\"tenant_id\");",
                  "});",
                  "var data = pm.response.json().data;",
                  "if (data && data.id) {",
                  "    pm.collectionVariables.set(\"user_id\", data.id);",
                  "    pm.collectionVariables.set(\"username\", data.username);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"alice_{{$timestamp}}\",\n    \"password\": \"123456\",\n    \"nickname\": \"Alice\",\n    \"email\": \"alice_{{$timestamp}}@example.com\",\n    \"phone\": \"13800000001\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/user/register",
              "host": ["{{base_url}}"],
              "path": ["user", "register"]
            },
            "description": "Register a new user. Username and email are suffixed with a timestamp to avoid 409 on repeat runs."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"code is 0\", function () {",
                  "    pm.expect(pm.response.json().code).to.eql(0);",
                  "});",
                  "pm.test(\"tenant_id is 0\", function () {",
                  "    pm.expect(pm.response.json().data.tenant_id).to.eql(0);",
                  "});",
                  "pm.test(\"role is TENANT_USER\", function () {",
                  "    pm.expect(pm.response.json().data.role).to.eql(\"TENANT_USER\");",
                  "});",
                  "var data = pm.response.json().data;",
                  "if (data && data.token) {",
                  "    pm.collectionVariables.set(\"token\", data.token);",
                  "    pm.collectionVariables.set(\"tenant_id\", data.tenant_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/user/login",
              "host": ["{{base_url}}"],
              "path": ["user", "login"]
            },
            "description": "Login with the registered user. Uses the username saved by Register. Saves token to collection variables."
          }
        },
